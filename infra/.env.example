# Copy to .env and adjust. NEVER commit real secrets.
# Used by: docker compose (infra/docker-compose.yml) and the Makefile.

# --- Database ---
POSTGRES_DB=logisticaportuaria
POSTGRES_USER=lp_app
POSTGRES_PASSWORD=lp_dev_password
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev
# Change in any non-local environment (>= 32 chars for HS256).
JWT_SECRET=change-me-in-production-please-32b
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8088

# --- Frontend ---
FRONTEND_PORT=8088

# --- Edge OCR ---
EDGE_OCR_PORT=8001
EDGE_OCR_VARIANT=cpu
# Model weights are mounted as a volume, never downloaded at runtime.
MODELS_DIR=/models
EVIDENCE_RETENTION_DAYS=7
FACE_BLUR_ENABLED=true
RECOGNIZE_CONFIDENCE_THRESHOLD=0.75
# Durable queue of the edge (events are never lost while the backend is down).
OUTBOX_PATH=/app/data/outbox.db

# --- MQTT ---
MOSQUITTO_PORT=1883
MOSQUITTO_WS_PORT=9001

# --- Demo identifiers ---
YARD_ID=11111111-1111-7111-8111-111111111111
GATE_ID=33333333-3333-7333-8333-333333333331

# --- Observability (profile: observability) ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
